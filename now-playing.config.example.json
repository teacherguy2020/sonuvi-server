{
  "projectName": "now-playing",
  "environment": "example",
  "timezone": "UTC",
  "nodes": [
    {
      "name": "pi-main",
      "ip": "sonuvi.local",
      "role": "both",
      "sshUser": "sonuvi"
    }
  ],
  "ports": {
    "api": 3101,
    "ui": 8101
  },
  "deployment": {
    "sourceOfTruthNode": "pi-main",
    "syncMethod": "scp"
  },
  "alexa": {
    "enabled": false,
    "publicDomain": "",
    "skillId": "",
    "webhookPath": "/alexa",
    "routeWebhookUrl": "",
    "stopWebhookUrl": ""
  },
  "paths": {
    "musicLibraryRoot": "/var/lib/mpd/music",
    "moodeUsbMount": "/media/Music",
    "piMountBase": "/var/lib/sonuvi/music",
    "podcastRoot": "/var/lib/sonuvi/empty-library/podcasts",
    "subscriptionsJson": "./subscriptions.json"
  },
  "features": {
    "podcasts": true,
    "ratings": true,
    "radio": true
  },
  "notifications": {
    "trackNotify": {
      "enabled": false,
      "pollMs": 3000,
      "dedupeMs": 15000,
      "alexaMaxAgeMs": 21600000
    },
    "pushover": {
      "token": "",
      "userKey": ""
    },
    "apns": {
      "topic": "",
      "environment": "auto",
      "tokensPath": "var/mobile-push-tokens.json"
    }
  },
  "display": {
    "idleBrandLine": "Sonuvi",
    "idleMessageLine": "Ready to play"
  }
}
