[Unit]
Description=Sonuvi public Alexa HTTPS (separate from private LAN browser)
After=network-online.target sonuvi-api.service
Wants=network-online.target
[Service]
User=caddy
Group=caddy
Environment=HOME=/var/lib/caddy
WorkingDirectory=/var/lib/caddy
ExecStart=/usr/bin/caddy run --config /etc/sonuvi/alexa-public.Caddyfile --adapter caddyfile
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/caddy
[Install]
WantedBy=multi-user.target
