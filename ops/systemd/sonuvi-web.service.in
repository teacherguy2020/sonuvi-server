[Unit]
Description=Sonuvi public web (repository-first immutable release)
After=network-online.target sonuvi-api.service
Wants=network-online.target
Requires=sonuvi-api.service
ConditionPathExists=/opt/sonuvi/current/public/release.json

[Service]
Type=simple
User=@SERVICE_ACCOUNT@
Group=@SERVICE_ACCOUNT@
WorkingDirectory=/opt/sonuvi/current
Environment=SONUVI_RELEASE_ROOT=/opt/sonuvi/releases/@RELEASE_ID@
Environment=SONUVI_PUBLIC_WEB_ROOT=/opt/sonuvi/current/public
Environment=SONUVI_RELEASE_MANIFEST=/opt/sonuvi/current/release-manifest.json
Environment=SONUVI_RELEASE_ID=@RELEASE_ID@
Environment=SONUVI_ACTIVATION_STATE=/var/lib/sonuvi/checkpoints/release-activation-state.json
Environment=SONUVI_WEB_PORT=8101
Environment=SONUVI_WEB_HOST=0.0.0.0
ExecStartPre=/usr/bin/node /opt/sonuvi/current/scripts/verify-current-release.mjs
ExecStart=/usr/bin/node /opt/sonuvi/current/scripts/serve-public-web.mjs
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
ReadOnlyPaths=/opt/sonuvi/current /var/lib/sonuvi/checkpoints

[Install]
WantedBy=multi-user.target
